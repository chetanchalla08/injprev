# Copy to backend/.env and adjust. Every value here is optional; defaults are shown.

# Where uploaded videos, pose data and the SQLite database live.
DATA_DIR=./data

# Pose model: "heavy" (most accurate, slower) or "full" (faster).
POSE_MODEL=heavy
MODEL_DIR=./models

# Upload limits.
MAX_UPLOAD_MB=300
MAX_DURATION_S=180
MIN_DURATION_S=1

# Analysis runs on at most this many frames per second of video.
ANALYSIS_MAX_FPS=60

# Sessions (video + derived data) are deleted automatically after this many days. 0 disables auto-delete.
RETENTION_DAYS=30

# How many times an unexpected processing failure is retried automatically.
MAX_ATTEMPTS=2

# Set to 1 when serving over HTTPS so the access cookie is marked Secure.
COOKIE_SECURE=0

# Comma-separated origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173

# --- Encryption at rest -------------------------------------------------------------------
# 32-byte key, base64. Generate with: .venv/bin/python -m app.crypto
# Keep a copy somewhere safe and OUTSIDE the data directory and its backups: data cannot be read without it.
# Empty = stored unencrypted. Data stored before a key was set stays readable (and unencrypted).
DATA_KEY=
# Set to 1 to refuse to start without DATA_KEY.
REQUIRE_ENCRYPTION=0

# --- Analysis stages (each can be switched off; docs/VALIDATION.md has the measured effect of each) ---
ENABLE_BALL=1          # ball tracking -> contact time where found (unvalidated contact point)
ENABLE_COURT=1         # court lines -> position on court (reports "unable to assess" unless 5+ lines are visible)
POSE_MODE=full_frame   # or "cropped": second pose pass on the player. Not better on the evaluation set; about twice as slow.

# --- Review and sharing -------------------------------------------------------------------
# Code a coach or clinician must enter to sign off evidence and wording. Empty = sign-off disabled.
REVIEWER_CODE=
SHARE_TTL_DAYS=7
SHARE_MAX_TTL_DAYS=30

# --- Optional plain-language rewording by an LLM (off by default; the app works fully without it) ---
# When on, the written findings (never video, pose data or health details) are sent to the Anthropic API.
ENABLE_LLM_SUMMARY=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Set to 1 to allow creating a clearly labelled synthetic stick-figure session for trying the UI.
ENABLE_DEMO=0
